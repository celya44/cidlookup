#!/usr/bin/php -q
<?php
$restrict_mods = true;
if (!@include_once(getenv('FREEPBX_CONF') ? getenv('FREEPBX_CONF') : '/etc/freepbx.conf')) {
	include_once('/etc/asterisk/freepbx.conf');
}
global $db;
$agidir = FreePBX::Config()->get('ASTAGIDIR');
require_once $agidir."/phpagi.php";

function get_groups($var){
	return (strpos($var,'agi_arg_') !== FALSE);
}

$base_dir = dirname(dirname(__FILE__));
$agi = new AGI();
$cm = FreePBX::Contactmanager();

$groups = explode('_',$argv[2]);
$lookuplen = "7";
$number = preg_replace("/[^0-9\*#]/","",$argv[1]);
$number = trim($number);
$quickResults = [];

if(!empty($groups) && !empty($number)){
    foreach($groups as $group){
        $sql = "SELECT * FROM contactmanager_entry_numbers n, contactmanager_group_entries e, contactmanager_groups g
WHERE g.owner = -1
AND g.id = :groupid
AND g.id = e.groupid
AND n.entryid = e.id
AND n.stripped
AND (
  (n.number = :stripped)
  OR (n.stripped = :stripped)
  OR (
    n.stripped LIKE :strippedlike
    AND CHAR_LENGTH(n.stripped) >= :lookuplength
    AND CHAR_LENGTH(:stripped) >= :lookuplength
  )
)";
        $sth = $db->prepare($sql);
        $sth->execute(array(
            ":groupid" => $group,
            ":strippedlike" => '%'.$number,
            ":stripped" => $number,
            ":lookuplength" => $lookuplen
         ));
        $quickResults = array_merge($quickResults, $sth->fetchAll(PDO::FETCH_ASSOC));
    }
}

if(!empty($quickResults)) {
    $data = $cm->getEntryByID($quickResults[0]['entryid']);
}else{
    $agi->set_variable("CMCID", 'Unknown');
    exit();
}
$first = !empty($data['fname'])?$data['fname']:'';
$last = !empty($data['lname'])?$data['lname']:'';
$company = !empty($data['company'])?$data['company']:'Unknown';
$displayname = !empty($data['displayname'])?$data['displayname']:'Unknown';

if(empty($first) && empty($last)){
  $first = 'Unknown';
}
switch($argv['3']){
  case '1':
    $agi->set_variable("CMCID", $displayname);
  break;
  case '2':
    $agi->set_variable("CMCID", $company);
  break;
  case '3':
    $agi->set_variable("CMCID", $last .' ' .$first);
  break;
  case '4':
  default:
    $agi->set_variable("CMCID", $first .' ' .$last);
  break;
}

exit();
